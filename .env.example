# URL de conexão do PostgreSQL (obrigatório)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/boiaclaude

# Chave da API OpenAI (obrigatório para interpretação por IA)
OPENAI_API_KEY=sk-sua-chave-aqui

# Modelo da OpenAI (opcional, padrão: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Chave da API Brave Search (obrigatório para pesquisa web)
# Crie grátis em: https://api.search.brave.com/ (2000 buscas/mês)
BRAVE_SEARCH_API_KEY=BSA-sua-chave-aqui

# Chave da API Serper (obrigatória para busca local)
# Crie grátis em: https://serper.dev/
SERPER_API_KEY=sua-chave-serper-aqui

# Distância máxima (km) para priorizar resultados de busca local.
# Padrão interno: 50 km. Se não houver resultados dentro do raio, retorna os mais próximos disponíveis.
LOCAL_MAX_DISTANCE_KM=50

# Painel web financeiro
# Porta HTTP do painel (padrão: 3000)
PORT=3000
# URL base pública do servidor (usada para gerar o link enviado pelo WhatsApp)
PAINEL_BASE_URL=https://seu-dominio.com
# Chave secreta para assinar os tokens JWT do painel (obrigatório — use uma string longa e aleatória)
JWT_SECRET=gere-uma-chave-secreta-longa-aqui

# URL do Redis para BullMQ (lembretes precisos com delay)
# Em produção: Redis Cloud, Upstash, ou instância própria
REDIS_URL=redis://localhost:6379

# Modo desenvolvimento: quando true, o bot só responde ao DEV_WHATSAPP_ID
DEV_MODE=false
DEV_WHATSAPP_ID=

# Chave de autenticação para rota /admin/send (usada pelo N8N)
ADMIN_API_KEY=cronos-admin-2026

# URL base pública para servir imagens enviadas via /admin/upload-image
PUBLIC_BASE_URL=https://seasy.host

# Webhook N8N para aprovação de posts Instagram
N8N_APROVADOR_WEBHOOK=https://n8n.seasy.host/webhook/cronos-aprovador

# Alexa — canal de voz Echo
# ID da skill Alexa (obtido no Alexa Developer Console após criar a skill)
# Formato: amzn1.ask.skill.<uuid>
ALEXA_SKILL_ID=

# Google Calendar — integração OAuth 2.0
# Crie em: https://console.cloud.google.com/apis/credentials (tipo: Web Application)
# Redirect URI: https://painel.cronosappai.com.br/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://painel.cronosappai.com.br/auth/google/callback
