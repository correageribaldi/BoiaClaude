# URL de conexão do PostgreSQL (obrigatório)
DATABASE_URL=postgresql://usuario:senha@localhost:5432/boiaclaude

# Chave da API OpenAI (obrigatório para interpretação por IA)
OPENAI_API_KEY=sk-sua-chave-aqui

# Modelo da OpenAI (opcional, padrão: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Chave da API Brave Search (obrigatório para pesquisa na internet)
# Crie grátis em: https://api.search.brave.com/ (2000 buscas/mês)
BRAVE_SEARCH_API_KEY=BSA-sua-chave-aqui

# Chave da API Google Maps Places (obrigatório para busca local)
# Ative Places API e gere em: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=sua-chave-google-aqui
